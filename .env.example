# ---------------------------------------------------------------- database
# MongoDB connection string. Prisma needs a replica set, so either a MongoDB
# Atlas cluster (easiest) or a local single-node replica set.
#   Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/the-maker?retryWrites=true&w=majority
#   Local:  mongodb://localhost:27017/the-maker?replicaSet=rs0
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/the-maker?retryWrites=true&w=majority"

# ------------------------------------------------------------------ public
# Absolute origin, no trailing slash. Used for canonicals, sitemap and OG tags.
# In production: https://themaker.ma
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------- uploads
# Optional. Folder uploaded photographs are saved in, relative to the project
# or absolute. Must be on a persistent disk. Defaults to ./uploads
# UPLOAD_DIR="uploads"

# ------------------------------------------------------------------- auth
# Signs the dashboard session cookie. At least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-me-with-a-long-random-string"

# ------------------------------------------------------------------- seed
# Only read by `npm run db:seed`. Re-seeding resets the admin password to this.
SEED_ADMIN_EMAIL="admin@themaker.ma"
SEED_ADMIN_NAME="Salma Bennani"
SEED_ADMIN_PASSWORD="change-this-before-seeding"
